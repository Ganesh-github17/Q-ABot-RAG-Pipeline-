# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Required: your OpenAI API key.
OPENAI_API_KEY=your-openai-api-key

# Models (defaults shown below are also used if these are left unset)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
# Heuristic distance cutoff used to flag weak/irrelevant retrieval.
# Smaller distance = more similar. This is NOT a scientifically optimal
# value -- see README.md "Known Limitations".
MAX_RELEVANT_DISTANCE=0.80

# Embeddings
EMBEDDING_BATCH_SIZE=32

# Storage
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=document_qa_bot
DATA_DIR=./data/documents
